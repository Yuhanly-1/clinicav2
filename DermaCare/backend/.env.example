# ===== DermaCare - Variables de entorno (copiar como .env) =====
NODE_ENV=development
PORT=3000

# Conexión PostgreSQL (local o proveedor en la nube)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/dermacare
# true en proveedores que exigen SSL (Render, Neon, Railway...)
DATABASE_SSL=false

# Clave larga y aleatoria. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_esta_clave_por_una_aleatoria
JWT_EXPIRES_IN=8h

# Zona horaria de la clínica (para "hoy", agenda y reportes)
APP_TIMEZONE=America/Santo_Domingo

# Solo si el frontend se sirve desde otro dominio (separar con comas)
CORS_ORIGIN=

# Administrador inicial: se crea al arrancar si no existe (mín. 8 caracteres)
ADMIN_NAME=Administrador DermaCare
ADMIN_EMAIL=admin@dermacare.demo
ADMIN_PASSWORD=

# Datos ficticios de demostración (usuarios demo + pacientes, citas, consultas)
SEED_DEMO_DATA=true
DEMO_PASSWORD=
